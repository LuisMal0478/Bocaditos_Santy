# ==============================================================================
# SEGURIDAD Y PRIVACIDAD: VARIABLES DE ENTORNO Y SECRETOS (NUNCA SUBIR A GIT)
# ==============================================================================
.env
.env.*
*.env
*.env.*
*.env.local
*.env.production
*.env.development
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
frontend/.env.local

# Permitir explícitamente únicamente las plantillas de ejemplo
!*.env.example
!**/.env.example

# Llaves privadas, certificados y credenciales
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa
id_ed25519

