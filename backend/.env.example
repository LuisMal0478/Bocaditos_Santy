# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO - BOCADITOS SANTY (BACKEND)
# Copia este archivo como .env para desarrollo local o añade estas variables en tu
# panel de hosting en la nube (Render, Railway, Fly.io, etc.).
# ==============================================================================

# 1. SEGURIDAD Y DEPURACIÓN
# En desarrollo: True | En producción: False (OBLIGATORIO)
DEBUG=False

# Clave secreta criptográfica de Django (Generar una cadena aleatoria de 50+ caracteres en producción)
SECRET_KEY=cambiar-por-una-clave-secreta-larga-y-segura-en-produccion

# 2. DOMINIOS Y HOSTS PERMITIDOS
# Dominios separados por coma que pueden consultar este backend
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.railway.app,.vercel.app

# 3. SEGURIDAD CORS (CONEXIÓN CON EL FRONTEND)
# URL del frontend desplegado en Vercel (ej: https://bocaditos-santy.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://bocaditos-santy.vercel.app

# 4. BASE DE DATOS
# En desarrollo local: Dejar vacío o comentado para usar SQLite automáticamente.
# En producción: Conectar a PostgreSQL (ej. Neon, Supabase, Railway o Render Postgres)
# DATABASE_URL=postgresql://usuario:contraseña@servidor.com:5432/nombre_db

# 5. ALMACENAMIENTO DE IMÁGENES EN LA NUBE (CLOUDINARY)
# Requerido en producción para que las imágenes de pasabocas y el logo no se borren
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# 6. CONFIGURACIÓN INICIAL POR DEFECTO DEL NEGOCIO
NUMERO_WHATSAPP_DEFECTO=+573018922819
